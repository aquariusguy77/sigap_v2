APP_NAME="SIGAP Rudenim Surabaya"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ============================================================
# TIDAK ADA DATABASE RELASIONAL
# Seluruh data disimpan di Firebase Realtime Database.
# ============================================================
DB_CONNECTION=null
SESSION_DRIVER=cookie
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
SESSION_LIFETIME=120

# ============================================================
# FIREBASE REALTIME DATABASE  (WAJIB)
# Salin dari Firebase Console -> Realtime Database.
# ============================================================
FIREBASE_DATABASE_URL=https://NAMA-PROYEK-default-rtdb.asia-southeast1.firebasedatabase.app/

# ============================================================
# KREDENSIAL FIREBASE  (WAJIB untuk menulis data)
#
# Firebase Console -> Project Settings -> Service accounts ->
# Generate new private key. Tempel SELURUH isi berkas JSON di
# bawah ini dalam satu baris, atau bentuk base64-nya.
#
# Dipakai untuk dua hal sekaligus:
#   - membaca dan menulis Realtime Database
#   - mengunggah berkas ke Firebase Storage
#
# JANGAN PERNAH commit nilai ini ke GitHub.
# ============================================================
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternatif lama bila tidak memakai service account.
FIREBASE_DATABASE_SECRET=

# ============================================================
# PENYIMPANAN BERKAS DOKUMEN
#
# local         = simpan di komputer sendiri. Hanya untuk pengembangan;
#                 di Vercel folder aplikasi bersifat baca-saja sehingga
#                 unggahan pasti ditolak.
# rtdb          = simpan isi berkas di Realtime Database sebagai base64.
#                 Tidak butuh bucket maupun paket Blaze, jadi bisa dipakai
#                 sejak paket Spark. INILAH PILIHAN UNTUK VERCEL.
# firebase-rest = unggah ke Firebase Storage. Paling rapi, tetapi Firebase
#                 mensyaratkan paket Blaze sebelum bucket bisa dibuat.
# ============================================================
FIREBASE_STORAGE_DISK=local

# Khusus mode rtdb. Node tempat isi berkas disimpan, terpisah dari
# metadata dokumen agar daftar dokumen tetap ringan dibaca.
FIREBASE_STORAGE_RTDB_NODE=document_files

# Batas ukuran per berkas dalam KB. Bawaan 5120 (5 MB), sama dengan batas
# pada formulir unggah.
FIREBASE_STORAGE_RTDB_MAX_KB=5120
FIREBASE_STORAGE_BUCKET=NAMA-PROYEK.firebasestorage.app
FIREBASE_STORAGE_PREFIX=documents
FIREBASE_STORAGE_PUBLIC_BASE_URL=

# Hanya untuk uji coba singkat; kedaluwarsa dalam 1 jam.
FIREBASE_STORAGE_BEARER_TOKEN=

# Dipakai halaman untuk keterangan saja.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=NAMA-PROYEK.firebaseapp.com

# ============================================================
# SIGAP — Kontrol Aplikasi
#
# Tidak ada lagi setelan mode masuk. Mode demo, SIGAP_LOGIN_MODE, dan
# SIGAP_ACTIVE_ROLE sudah dihapus karena ketiganya dapat membuka akses
# tanpa kata sandi. Satu-satunya jalan masuk adalah akun terdaftar.
# ============================================================
# Kata sandi tiga akun awal. Dikosongkan = dibuatkan acak oleh
# php artisan sigap:seed dan ditampilkan sekali di layar. Jangan pernah
# menuliskannya di dalam kode, karena repositori ini bersifat publik.
SIGAP_SEED_ADMIN_PASSWORD=
SIGAP_SEED_PETUGAS_PASSWORD=
SIGAP_SEED_SUPERVISOR_PASSWORD=

SIGAP_SAMPLE_DATA_ENABLED=false
SIGAP_FIREBASE_READ_ENABLED=true

# ============================================================
# Pembatas percobaan masuk
#
# Hitungannya disimpan di Firebase pada node login_attempts, bukan di cache
# Laravel. Di Vercel CACHE_STORE bernilai "array" dan hanya hidup selama satu
# permintaan, jadi middleware throttle bawaan tidak membatasi apa pun di sana.
#
# Satuan WINDOW dan LOCK adalah detik. Biarkan kosong untuk memakai bawaannya.
#
#   MAX / WINDOW / LOCK        : satu akun dari satu alamat IP (batas utama)
#   EMAIL_MAX / EMAIL_WINDOW   : satu akun dari alamat mana pun (jaring kedua)
#   PRUNE_CHANCE               : 1 dari sekian kegagalan dipakai sekalian untuk
#                                membersihkan catatan kedaluwarsa; 0 mematikan
# ============================================================
SIGAP_LOGIN_THROTTLE=true
SIGAP_LOGIN_THROTTLE_MAX=5
SIGAP_LOGIN_THROTTLE_WINDOW=900
SIGAP_LOGIN_THROTTLE_LOCK=900
SIGAP_LOGIN_THROTTLE_EMAIL_MAX=20
SIGAP_LOGIN_THROTTLE_EMAIL_WINDOW=900
SIGAP_LOGIN_THROTTLE_EMAIL_LOCK=1800
SIGAP_LOGIN_THROTTLE_PRUNE_CHANCE=20

# ============================================================
# Pembuatan PDF
# ============================================================
DOMPDF_TEMP_DIR=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@sigap-rudenim.local"
MAIL_FROM_NAME="${APP_NAME}"
